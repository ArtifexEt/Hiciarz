# Empty template for your own integration. Copy to .env.local and load it into
# your shell environment; Gradle does not automatically read .env files.
# Client IDs are public build configuration, but this repository provides none.
SPOTIFY_CLIENT_ID=

# Keep false for offline UI/unit-test builds. Distribution workflows set true.
HICIARZ_REQUIRE_SPOTIFY_CONFIG=false

# Private signing configuration. Store the keystore outside tracked files.
HICIARZ_KEYSTORE_FILE=
HICIARZ_KEYSTORE_PASSWORD=
HICIARZ_KEY_ALIAS=
HICIARZ_KEY_PASSWORD=
HICIARZ_PRODUCTION_SIGNING=false

# Firebase App Distribution is configured separately in your GitHub repository.
# No Firebase client/project identifiers or service-account credentials belong
# in this template or in the APK. See the Android README for setup.
FIREBASE_PROJECT_ID=
FIREBASE_APP_ID=
FIREBASE_TESTER_GROUPS=
FIREBASE_WORKLOAD_IDENTITY_PROVIDER=
FIREBASE_SERVICE_ACCOUNT=
